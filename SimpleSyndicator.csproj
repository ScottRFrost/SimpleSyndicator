<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15.0</LangVersion>
    <Features>$(Features);runtime-async=on</Features>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlaywrightPlatform>linux-x64;win-x64</PlaywrightPlatform>
    <StartupObject>SimpleSyndicator.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="config.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config.json" Condition="Exists('config.json')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageReference Include="Ruri.GhostCursorSharp.Playwright" Version="0.3.0" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
    <PackageReference Include="Telegram.Bot" Version="22.10.5" />
  </ItemGroup>

</Project>
